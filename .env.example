# Powers the AI fallback for Jr Yash (src/app/api/yash-chat/route.ts).
# Without these, known questions still answer instantly from local data -
# only novel questions silently fall back to the static "I don't know that
# yet" message instead of calling an AI model.

# Required for the AI answers themselves.
# Get a free key at https://aistudio.google.com/app/apikey (no card required).
GEMINI_API_KEY=

# Optional - defaults to gemini-3.5-flash-lite (free-tier eligible).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional but strongly recommended once this is live: without these, AI
# answers aren't cached across visitors (every repeat question re-calls the
# AI), rate limiting is only best-effort per server instance rather than
# shared, and the contact form below has no rate limiting at all.
# Free tier at https://console.upstash.com -> create a Redis database ->
# copy the REST URL and token from its dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Powers the contact form actually sending email
# (src/app/api/contact/route.ts). Without this, the form still works - it
# just falls back to opening an email draft in the visitor's own email app,
# same as before.
# Free tier at https://resend.com -> API Keys -> create one. No domain
# verification needed to start (sends from onboarding@resend.dev); replies
# go to the visitor's own address either way via reply-to.
RESEND_API_KEY=
