# Powers the AI fallback for Jr Yash (src/app/api/yash-chat/route.ts).
# Without these, known questions still answer instantly from local data -
# only novel questions silently fall back to the static "I don't know that
# yet" message instead of calling an AI model.

# Required for the AI answers themselves.
# Get a free key at https://aistudio.google.com/app/apikey (no card required).
GEMINI_API_KEY=

# Optional - defaults to gemini-2.5-flash-lite (free-tier eligible).
# GEMINI_MODEL=gemini-2.5-flash-lite

# Optional but strongly recommended once this is live: without these, AI
# answers aren't cached across visitors (every repeat question re-calls the
# AI) and rate limiting is only best-effort per server instance, not shared.
# Free tier at https://console.upstash.com -> create a Redis database ->
# copy the REST URL and token from its dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
